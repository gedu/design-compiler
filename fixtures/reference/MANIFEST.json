      "expressiveOnly": []
    },
    {
      "id": "States.Desktop",
      "image": "screens/States.Desktop.png",
      "html": "screens/States.Desktop.html",
      "spec": "SCREENS.md#homescreenkt",
      "states": [
        "hoverCard",
        "hoverRow",
        "hoverIconButton",
        "focusSearch",
        "focusToggle",
        "minimumWidth"
      ],
      "expressiveOnly": []
